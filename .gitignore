/.vs/

# The local Ghidra database is host-specific. Keep its project files locally,
# but do not add the database to Git.
/archive/ghidra_analysis_project/ShadowRunGenesis.gpr
/archive/ghidra_analysis_project/ShadowRunGenesis.rep/
/archive/retired_analysis/analysis/ghidra-*/
/archive/retired_analysis/analysis/retired/webm_ffmpeg_microframes/capture-audio.wav
/archive/qa-artifacts/

# Host-rendered diagnostics are not extracted game assets. Keep reviewed
# resource images in the explicitly allowed folders below.
/assets/**/*.bmp
/assets/**/*.png
/assets/**/*.jpg
/assets/native/*.srna
!/assets/title/
!/assets/title/**/*.bmp
!/assets/boot/
!/assets/boot/**/*.bmp
!/assets/startup/
!/assets/startup/**/*.bmp
!/assets/intro/
!/assets/intro/**/*.bmp
!/assets/field/
!/assets/field/**/*.bmp
!/assets/field/maps/*-priority-overlay.png
!/assets/field/entities/target-marker/*.png
!/assets/manifest.tsv

# Per-machine research utilities and gameplay-video analysis are kept outside
# normal source control.
/tools/rom_research/ffmpeg/
/video analysis/
/archive/handoffs/deepseek.txt
/Shadow Run (U) *.zip

# Local dumps and logs beside the repository root.
/*.bmp
/*.png
/*.jpg
/*.log

