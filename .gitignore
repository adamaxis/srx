# Build outputs remain local. The active project lives under
# decompilation/ghidra_conversion; the surrounding decompilation directory also
# holds shared ROM inputs, Ghidra exports, assets, scripts, and documentation.
/build/
**/build/
**/build-*/
**/bin/
**/obj/
**/Testing/
**/CMakeFiles/
**/CMakeCache.txt
**/build.ninja
**/.ninja_deps
**/.ninja_log
**/cmake_install.cmake
**/compile_commands.json
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.dll
**/*.exe
**/*.exp
**/*.pdb
**/*.ilk
**/*.idb
**/*.pch
**/*.ipch
**/*.tlog
**/*.lastbuildstate

# Python caches and standalone viewer output.
**/__pycache__/
**/*.py[cod]
/decompilation/ghidra_conversion/tools/map_entity_viewer/dist/

# Local Visual Studio state and databases.
**/.vs/
**/*.suo
**/*.user
**/*.VC.db
**/*.VC.VC.opendb
**/*.sdf
**/*.opensdf
**/*.opendb
/.vs/

# The local Ghidra database is host-specific. Keep its project files locally,
# but do not add the database to Git.
/archive/ghidra_analysis_project/ShadowRunGenesis.gpr
/archive/ghidra_analysis_project/ShadowRunGenesis.rep/
/archive/retired_analysis/analysis/ghidra-*/
/archive/retired_analysis/analysis/retired/webm_ffmpeg_microframes/capture-audio.wav
/archive/qa-artifacts/

# Host-rendered diagnostics are not extracted game assets. Keep reviewed
# resource images in the explicitly allowed folders below.
/decompilation/assets/**/*.bmp
/decompilation/assets/**/*.png
/decompilation/assets/**/*.jpg
/decompilation/assets/native/*.srna
!/decompilation/assets/title/
!/decompilation/assets/title/**/*.bmp
!/decompilation/assets/boot/
!/decompilation/assets/boot/**/*.bmp
!/decompilation/assets/startup/
!/decompilation/assets/startup/**/*.bmp
!/decompilation/assets/intro/
!/decompilation/assets/intro/**/*.bmp
!/decompilation/assets/field/
!/decompilation/assets/field/**/*.bmp
!/decompilation/assets/field/maps/*-priority-overlay.png
!/decompilation/assets/field/entities/target-marker/*.png
!/decompilation/assets/manifest.tsv

# Per-machine research utilities and gameplay-video analysis are kept outside
# normal source control.
/decompilation/ghidra_conversion/tools/rom_research/ffmpeg/
/video analysis/
/archive/handoffs/deepseek.txt
/Shadow Run (U) *.zip

# Local dumps and logs beside the repository root.
/*.bmp
/*.png
/*.jpg
/*.log

# Keep only the project-level VS Code integration files.
/.vscode/*
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/tasks.json
