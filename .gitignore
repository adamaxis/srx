# CMake/Ninja build products are regenerated per checkout.
/build-ide-*/
/decompilation/build/
/decompilation/build-*/
/decompilation/ghidra_conversion/build/
/decompilation/ghidra_conversion/build-ghidra-conversion-*/
/decompilation/ghidra_conversion/Testing/

# Ghidra project databases are large, host-specific working state. The
# exported listings and C++ evidence under export/ remain versioned.
/decompilation/ShadowRunGenesis.gpr
/decompilation/ShadowRunGenesis.rep/
/decompilation/analysis/ghidra-*/

# Host-rendered diagnostics and explicit extraction outputs.
/decompilation/assets/**/*.bmp
/decompilation/assets/**/*.png
/decompilation/assets/**/*.jpg
/decompilation/assets/native/*.srna
!/decompilation/assets/title/
!/decompilation/assets/title/**/*.bmp
!/decompilation/assets/boot/
!/decompilation/assets/boot/**/*.bmp
!/decompilation/assets/startup/
!/decompilation/assets/startup/**/*.bmp
!/decompilation/assets/intro/
!/decompilation/assets/intro/**/*.bmp
!/decompilation/assets/field/
!/decompilation/assets/field/**/*.bmp
!/decompilation/assets/manifest.tsv

# Local screenshot and raw listing diagnostics are disposable analysis output,
# not reconstructed game resources or source.
/*.bmp
/decompilation/*.bmp
/decompilation/*.png
/decompilation/*.jpg
/decompilation/*.txt
/decompilation/*.log

# Keep the project-level VS Code/CMake integration, while ignoring other local
# editor state.
/.vs/
/.vscode/*
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/tasks.json

decompilation/tools/ffmpeg
video analysis/
