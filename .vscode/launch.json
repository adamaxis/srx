{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shadowrun Ghidra Conversion Qt (Release)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/conversion/qt/release/shadowrun_ghidra_conversion_qt.exe",
      "args": [
        "--assets",
        "${workspaceFolder}/decompilation/assets"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/decompilation/ghidra_conversion",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "Shadowrun Conversion Qt: Build (Release)",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;C:\\Qt\\6.9.1\\mingw_64\\bin;${env:PATH}"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Shadowrun Ghidra Conversion Workbench (Release)",
