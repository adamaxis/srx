{
  "version": 6,
  "vendor": {
    "shadowrun": {
      "purpose": "Visual Studio/CMake IDE umbrella only; standalone native and Ghidra projects remain independently buildable."
    }
  },
  "configurePresets": [
    {
      "name": "shadowrun-ide-debug",
      "displayName": "Shadowrun IDE (Debug, MSYS2 UCRT64)",
      "description": "IDE umbrella configure for separate native-port and Ghidra-conversion targets.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ide/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      }
    },
    {
      "name": "shadowrun-ide-release",
      "displayName": "Shadowrun IDE (Release, MSYS2 UCRT64)",
      "description": "IDE umbrella release configure for separate native-port and Ghidra-conversion targets.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ide/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      }
    },
    {
      "name": "shadowrun-ide-msvc-debug",
      "displayName": "Shadowrun IDE (Debug, Visual Studio 2022)",
      "description": "IDE umbrella configure using the Visual Studio generator.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/ide/msvc/debug"
    }
  ],
  "buildPresets": [
    {
      "name": "shadowrun-ide-ghidra-debug",
      "displayName": "Build Ghidra Conversion (IDE Debug)",
      "configurePreset": "shadowrun-ide-debug",
      "targets": ["shadowrun_ghidra_conversion_runner"]
    },
    {
      "name": "shadowrun-ide-native-debug",
      "displayName": "Build Native Port (IDE Debug)",
      "configurePreset": "shadowrun-ide-debug",
      "targets": ["shadowrun_native"]
    },
    {
      "name": "shadowrun-ide-all-debug",
      "displayName": "Build All IDE Targets (Debug)",
      "configurePreset": "shadowrun-ide-debug"
    },
    {
      "name": "shadowrun-ide-ghidra-msvc-debug",
      "displayName": "Build Ghidra Conversion (Visual Studio Debug)",
      "configurePreset": "shadowrun-ide-msvc-debug",
      "configuration": "Debug",
      "targets": ["shadowrun_ghidra_conversion_runner"]
    }
  ],
  "testPresets": [
    {
      "name": "shadowrun-ide-debug",
      "displayName": "CTest (IDE Debug)",
      "configurePreset": "shadowrun-ide-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
