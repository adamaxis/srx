          "fallback": "topic_state_boundary"
        },
        "topic_state_boundary": {
          "type": "source_boundary",
          "reason": "Boris topic selection requires the source story and Group Item facts used by the ordered topic gates."
        },
        "first_information_topics": {
          "type": "choice",
          "menuId": "information_topics",
          "promptTextKey": "boris.greenhouse.page.paid_information",
