          "type": "page",
          "eventId": "repeat",
          "next": "repeat_menu"
        },
        "opening_menu": {
          "type": "choice",
          "menuId": "opening",
          "promptTextKey": "boris.greenhouse.page.opening",
          "inputContract": "buttons_abc",
          "choices": [
            { "id": "story", "next": "story_offer_check" },
            { "id": "information", "next": "information_offer_check" },
            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "repeat_menu": {
          "type": "choice",
          "menuId": "repeat_opening",
          "promptTextKey": "boris.greenhouse.page.repeat",
          "inputContract": "buttons_abc",
