        "alternate_greeting": {
          "type": "action",
          "actionId": "boris.clear_field_dialogue_flag",
          "arguments": { "flagBit": 1 },
          "next": "alternate_0_page"
        },
        "alternate_0_page": {
          "type": "page",
          "eventId": "alternate_0",
          "next": "after_michael_menu"
        },
        "after_michael_menu": {
