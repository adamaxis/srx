{
  "schemaVersion": 1,
  "graphs": {
    "boris_greenhouse.indexed_title_service": {
      "entryNode": "alternate_result",
      "precondition": "boris_greenhouse.indexed_service_available",
      "speakerId": "boris_greenhouse_narrator",
      "textProfile": "boris.greenhouse",
      "provenance": {
        "romAddresses": ["0x53F8C", "0x1F246", "0x173110", "0x21A32", "0x21A66", "0x21B6A", "0x21B82", "0x21BE4", "0x21C0C", "0x21C38", "0x21C72", "0x22874", "0xF52C0", "0xF52D8", "0xF52EC", "0xF54FC", "0xF5518", "0xF5534", "0xF5550", "0xF5AE8", "0xF8A88", "0xF9332", "0xF9385", "0xF9440", "0xF94C8", "0xF95E2", "0xF9570", "0xFE5BF", "0x21EB0"],
        "scope": "scene_2_event_6_visa_maglock_passkey_and_mach_22_purchases_with_partially_converted_strike_team_outcome"
      },
      "nodes": {
        "alternate_result": {
          "type": "branch",
          "cases": [
            { "when": "boris_greenhouse.alternate_result_positive", "next": "package_request" },
            { "when": "boris_greenhouse.alternate_result_negative", "next": "package_payment" }
