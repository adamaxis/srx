            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "charge_story_offer": {
          "type": "action",
          "actionId": "building.charge_amount",
          "arguments": { "amount": 100 },
          "results": {
            "paid": "mark_story_offer_paid",
            "insufficient": "insufficient_funds"
          },
          "evidence": "ROM command 0x27 charges 100 nuyen and records FFFC26 bit 0 after payment succeeds."
        },
        "mark_story_offer_paid": {
          "type": "action",
          "actionId": "boris.mark_paid_dialogue_flag",
