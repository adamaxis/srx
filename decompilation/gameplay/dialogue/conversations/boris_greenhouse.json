            { "id": "maglock_passkey", "next": "purchase_maglock_passkey" },
            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "firearm_items_menu": {
          "type": "choice",
          "menuId": "firearm_items",
          "promptTextKey": "boris.greenhouse.page.firearm_inventory",
