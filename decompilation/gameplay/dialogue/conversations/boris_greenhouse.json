        "michael_unknown_menu": {
          "type": "choice",
          "menuId": "opening",
          "promptTextKey": "boris.greenhouse.page.michael_unknown",
          "inputContract": "buttons_abc",
          "choices": [
            { "id": "story", "next": "story_offer_check" },
            { "id": "information", "next": "information_offer_check" },
            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "michael_repeat_menu": {
          "type": "choice",
          "menuId": "opening",
          "promptTextKey": "boris.greenhouse.page.michael_repeat",
          "inputContract": "buttons_abc",
          "choices": [
            { "id": "story", "next": "story_offer_check" },
            { "id": "information", "next": "information_offer_check" },
            { "id": "later", "next": "stay_on_map" }
          ]
