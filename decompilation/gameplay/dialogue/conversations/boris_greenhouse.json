        "repeat_information_topics": {
          "type": "choice",
          "menuId": "information_topics",
          "promptTextKey": "boris.greenhouse.page.paid_information_repeat",
          "inputContract": "buttons_abc",
          "choices": [
            { "id": "michael", "next": "michael_information_check" },
            { "id": "david", "when": "boris_greenhouse.david_topic_available", "next": "prepare_david_information" },
            { "id": "ilene", "when": "boris_greenhouse.ilene_topic_available", "next": "mark_ilene_information" },
            { "id": "thon", "when": "boris_greenhouse.thon_topic_available", "next": "thon_information" },
            { "id": "later", "next": "stay_on_map" }
