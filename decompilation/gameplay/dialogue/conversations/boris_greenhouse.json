          "menuId": "story_services",
          "promptTextKey": "boris.greenhouse.page.privacy_request",
          "inputContract": "buttons_abc",
          "choices": [
            { "id": "items", "next": "item_categories_menu" },
            { "id": "information", "next": "information_offer_check" },
            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "item_categories_menu": {
          "type": "choice",
          "menuId": "item_categories",
          "promptTextKey": "boris.greenhouse.page.item_category_prompt",
          "inputContract": "buttons_abc",
          "choices": [
            { "id": "equipment", "next": "equipment_items_menu" },
            { "id": "firearms", "next": "firearm_items_menu" },
            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "equipment_items_menu": {
          "type": "choice",
          "menuId": "equipment_items",
          "promptTextKey": "boris.greenhouse.page.equipment_inventory",
