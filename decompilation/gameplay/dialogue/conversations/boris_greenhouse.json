          "choices": [
            { "id": "mach_22", "next": "purchase_mach_22" },
            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "charge_passport": {
          "type": "action",
          "actionId": "building.charge_amount",
          "arguments": { "amount": 1000 },
          "results": {
            "paid": "mark_passport_owned",
            "insufficient": "insufficient_funds"
          },
          "evidence": "ROM command 0x2D at 0x21C0C debits 1,000 nuyen and sets FFFC22 bit 1, the Indian Lands Visa group-item flag."
        },
        "mark_passport_owned": {
          "type": "action",
          "actionId": "item.set_group_flag",
          "arguments": { "flagBit": 1, "value": true },
          "next": "post_purchase_menu"
        },
        "post_purchase_menu": {
          "type": "choice",
          "menuId": "post_purchase",
          "promptTextKey": "boris.greenhouse.page.purchase_confirmation",
          "inputContract": "buttons_abc",
          "choices": [
            { "id": "story", "next": "story_offer_check" },
            { "id": "information", "next": "information_offer_check" },
            { "id": "later", "next": "stay_on_map" }
          ]
        },
        "purchase_maglock_passkey": {
          "type": "action",
          "actionId": "building.purchase_runner_item",
          "arguments": { "itemCode": 20, "rating": 2, "amount": 10000 },
          "results": {
            "purchased": "post_purchase_menu",
            "inventory_full": "inventory_full",
            "insufficient": "insufficient_funds"
          },
          "evidence": "ROM command 0x2E at 0x21C38 calls 0x22874 to select the first free active-runner item slot before charging 10,000 nuyen, then writes item 0x14 with rating 2 and returns to 0xF5534."
        },
        "inventory_full": {
          "type": "page",
          "eventId": "inventory_full",
          "next": "stay_on_map"
        },
        "purchase_mach_22": {
          "type": "action",
          "actionId": "building.purchase_runner_item",
          "arguments": { "itemCode": 10, "rating": 0, "amount": 1200 },
          "results": {
            "purchased": "post_purchase_menu",
            "inventory_full": "inventory_full",
            "insufficient": "insufficient_funds"
          },
          "evidence": "ROM command 0x2F at 0x21C72 calls 0x22874 before charging 0x4B0 through 0x21A4E, writes item 0x0A and clears its +8 rating byte, then returns to 0xF5534."
        },
        "insufficient_funds": {
          "type": "page",
          "eventId": "insufficient_funds",
          "next": "stay_on_map"
