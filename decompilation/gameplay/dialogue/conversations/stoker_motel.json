        "jump_house_after_insufficient": { "type": "page", "eventId": "jump-house", "next": "stay_on_map" },
        "prepare_referral": {
          "type": "action",
          "actionId": "stoker_motel.prepare_referral",
          "results": { "ready": "jump_house", "service_unavailable": "referral_boundary" }
