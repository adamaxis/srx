            { "id": "debt-payment", "next": "pay_debt" },
            { "id": "jump-house", "next": "prepare_referral" }
          ]
        },
        "pay_debt": {
          "type": "action",
          "actionId": "stoker_motel.pay_debt",
          "results": {
            "paid": "record_paid_debt",
            "insufficient": "jump_house_after_insufficient",
            "service_unavailable": "debt_payment_boundary"
          },
          "evidence": "ROM 0x213FA checks 250 nuyen; paid and insufficient branches have separate source effects."
        },
        "record_paid_debt": {
          "type": "action",
          "actionId": "story.set_fact",
          "arguments": {"factId":"motel_bill_paid","value":true},
          "next": "michael_package_contents"
