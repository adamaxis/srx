{
  "version": 6,
  "vendor": {
    "shadowrun": {
      "toolchainPolicy": "The Ghidra conversion workbench uses the MSYS2 UCRT64 toolchain and never shares a build directory with the native port."
    }
  },
  "configurePresets": [
    {
      "name": "ghidra-conversion-debug",
      "displayName": "Ghidra Conversion Workbench (Debug, MSYS2 UCRT64)",
      "description": "Debug build of the standalone ROM-to-readable-C++ conversion workbench.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/conversion/workbench/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      }
    },
    {
      "name": "ghidra-conversion-release",
      "displayName": "Ghidra Conversion Workbench (Release, MSYS2 UCRT64)",
      "description": "Release build of the standalone ROM-to-readable-C++ conversion workbench.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/conversion/workbench/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      }
    },
    {
      "name": "ghidra-conversion-qt-debug",
      "displayName": "Ghidra Conversion Qt (Debug, MSYS2 UCRT64)",
      "description": "Separate Qt build of the converted startup/runtime contracts.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/conversion/qt/debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;C:/Qt/6.9.1/mingw_64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "SHADOWRUN_GHIDRA_QT_FRONTEND": "ON",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.9.1/mingw_64"
      }
    },
    {
      "name": "ghidra-conversion-qt-release",
      "displayName": "Ghidra Conversion Qt (Release, MSYS2 UCRT64)",
      "description": "Separate release Qt build of the converted startup/runtime contracts.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/conversion/qt/release",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;C:/Qt/6.9.1/mingw_64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "SHADOWRUN_GHIDRA_QT_FRONTEND": "ON",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.9.1/mingw_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ghidra-conversion-debug",
      "displayName": "Build Ghidra Conversion Workbench (Debug)",
      "configurePreset": "ghidra-conversion-debug",
      "targets": [
        "shadowrun_ghidra_conversion_runner"
      ]
    },
    {
      "name": "ghidra-conversion-debug-all",
      "displayName": "Build All Ghidra Conversion Tests (Debug)",
      "configurePreset": "ghidra-conversion-debug"
    },
    {
      "name": "ghidra-conversion-release",
      "displayName": "Build Ghidra Conversion Workbench (Release)",
      "configurePreset": "ghidra-conversion-release",
      "targets": [
        "shadowrun_ghidra_conversion_runner"
      ]
    },
    {
      "name": "ghidra-conversion-qt-debug",
      "displayName": "Build Ghidra Conversion Qt (Debug)",
      "configurePreset": "ghidra-conversion-qt-debug",
      "targets": [
        "shadowrun_ghidra_conversion_qt",
        "shadowrun_ghidra_movement_mode_transition_test"
      ]
    },
    {
      "name": "ghidra-conversion-qt-release",
      "displayName": "Build Ghidra Conversion Qt (Release)",
      "configurePreset": "ghidra-conversion-qt-release",
      "targets": [
        "shadowrun_ghidra_conversion_qt",
        "shadowrun_ghidra_movement_mode_transition_test"
      ]
    },
    {
      "name": "ghidra-conversion-release-all",
      "displayName": "Build All Ghidra Conversion Tests (Release)",
      "configurePreset": "ghidra-conversion-release"
    }
  ],
  "testPresets": [
    {
      "name": "ghidra-conversion-debug",
      "displayName": "Test Ghidra Conversion Workbench (Debug)",
      "configurePreset": "ghidra-conversion-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ghidra-conversion-release",
      "displayName": "Test Ghidra Conversion Workbench (Release)",
      "configurePreset": "ghidra-conversion-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "ghidra-conversion-qt-debug",
      "displayName": "Ghidra Conversion Qt (Debug, MSYS2 UCRT64)",
      "steps": [
        { "type": "configure", "name": "ghidra-conversion-qt-debug" },
        { "type": "build", "name": "ghidra-conversion-qt-debug" }
      ]
    },
    {
      "name": "ghidra-conversion-qt-release",
      "displayName": "Ghidra Conversion Qt (Release, MSYS2 UCRT64)",
      "steps": [
        { "type": "configure", "name": "ghidra-conversion-qt-release" },
        { "type": "build", "name": "ghidra-conversion-qt-release" }
      ]
    }
  ]
}
