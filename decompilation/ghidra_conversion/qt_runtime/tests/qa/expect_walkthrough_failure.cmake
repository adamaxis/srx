foreach(required_var TEST_EXECUTABLE ASSET_ROOT SEGMENT OUTPUT_DIR
        BUG_ID EXPECTED_FAILURE_PATTERN)
    if(NOT DEFINED ${required_var})
        message(FATAL_ERROR "missing -D${required_var}")
    endif()
endforeach()

set(command "${TEST_EXECUTABLE}" --assets "${ASSET_ROOT}"
    --walkthrough "${SEGMENT}" "${OUTPUT_DIR}")
if(DEFINED INITIAL_SCENE)
    list(APPEND command --initial-scene "${INITIAL_SCENE}")
endif()
execute_process(
    COMMAND ${command}
    RESULT_VARIABLE result
    OUTPUT_VARIABLE stdout
    ERROR_VARIABLE stderr)
set(output "${stdout}\n${stderr}")
if(result EQUAL 0)
    message(FATAL_ERROR
        "${BUG_ID}: expected walkthrough failure, but the beat passed\n${output}")
endif()
if(NOT output MATCHES "${EXPECTED_FAILURE_PATTERN}")
    message(FATAL_ERROR
        "${BUG_ID}: failure did not match '${EXPECTED_FAILURE_PATTERN}' "
        "(result=${result})\n${output}")
endif()
if(DEFINED EXPECTED_AFTER_SCENE OR DEFINED EXPECTED_AFTER_STORY)
    set(steps_path "${OUTPUT_DIR}/steps.tsv")
    if(NOT EXISTS "${steps_path}")
        message(FATAL_ERROR "${BUG_ID}: walkthrough did not write ${steps_path}")
    endif()
    file(READ "${steps_path}" steps)
    string(ASCII 9 tab)
    if(NOT DEFINED EXPECTED_STEP_ID)
        message(FATAL_ERROR "${BUG_ID}: missing -DEXPECTED_STEP_ID")
    endif()
    set(step_token "${SEGMENT}\t${EXPECTED_STEP_ID}\t")
    string(REPLACE "\\t" "${tab}" step_token "${step_token}")
    string(FIND "${steps}" "${step_token}" row_index)
    if(row_index EQUAL -1)
        message(FATAL_ERROR "${BUG_ID}: expected step row is missing")
    endif()
    string(SUBSTRING "${steps}" ${row_index} -1 step_row)
    foreach(field RANGE 1 6)
        string(FIND "${step_row}" "${tab}" delimiter)
        if(delimiter EQUAL -1)
            message(FATAL_ERROR "${BUG_ID}: malformed walkthrough step row")
        endif()
        math(EXPR next_field "${delimiter} + 1")
        string(SUBSTRING "${step_row}" ${next_field} -1 step_row)
    endforeach()
    string(FIND "${step_row}" "${tab}" after_end)
    if(after_end EQUAL -1)
        message(FATAL_ERROR "${BUG_ID}: walkthrough after-state is missing")
    endif()
    string(SUBSTRING "${step_row}" 0 ${after_end} after_state)
    string(FIND "${after_state}" "scene=${EXPECTED_AFTER_SCENE};" scene_index)
    string(FIND "${after_state}" "story=${EXPECTED_AFTER_STORY};" story_index)
    if(NOT scene_index EQUAL 0 OR story_index EQUAL -1)
        message(FATAL_ERROR
            "${BUG_ID}: unexpected after-state '${after_state}'")
    endif()
endif()
message(STATUS "${BUG_ID}: observed expected walkthrough failure")
